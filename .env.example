# Public key used by ClerkJS in the browser.
CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Server-side Clerk verification. Keep these out of Git.
# CLERK_JWT_KEY is the PEM public key from Clerk Dashboard → API keys.
CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----
CLERK_SECRET_KEY=sk_test_your_key_here

# Hugging Face token for the authenticated sync endpoint.
HF_TOKEN=hf_your_token_here
