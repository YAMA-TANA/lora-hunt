{
  "name": "lora-hunt",
  "version": "0.1.0",
  "private": true,
  "description": "Search, compare, and review Hugging Face LoRAs.",
  "scripts": {
    "dev": "npx wrangler pages dev public --d1=DB=lora-hunt-db --local",
    "types": "npx wrangler types",
    "check": "npx wrangler check",
    "sync:hf": "node scripts/bootstrap-hf.mjs && node scripts/bootstrap-datasets.mjs",
    "sync:datasets": "node scripts/bootstrap-datasets.mjs",
    "build:seo": "node scripts/build-seo-pages.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "deploy": "npx wrangler pages deploy public --project-name=lora-hunt"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.14.1"
  }
}
